          "end": "float_seconds",
          "duration": "float_seconds",
          "role": "hook|explanation|contrast|climax|cta",
          "shot_type": "wide|medium|close|detail|overhead|split|insert",
          "framing": "string",
          "camera": "string",
          "visual_goal": "string",
